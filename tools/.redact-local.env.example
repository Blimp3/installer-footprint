# Copy to tools/.redact-local.env (git-ignored) and fill in. Never commit the copy.
# Real values that must never appear in a tracked file:
REDACT_USER=yourname
REDACT_HOST=hostname-of-your-mac
# Optional, comma-separated: more strings that redact.py replaces with <redacted>,
# or with your own text when written as text=>replacement.
REDACT_EXTRA=
# Optional, comma-separated: strings that verify_redaction.sh rejects in tracked
# files, for example the names of your other software or unrelated DNS names.
REDACT_DENY=
# Optional: the directory that holds the raw analysis folders (default: $HOME).
RAW_ROOT=
